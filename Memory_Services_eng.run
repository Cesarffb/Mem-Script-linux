#!/usr/bin/env bash
# -------------------------------------------------------------------
# Script: memory_services.run
# Description: Interactive installer for memory management services:
#              - Swap refresh (based on % free memory or % swap used)
#              - Cache cleaning (based on % of buff/cache)
#              Includes installation, uninstallation, and timer help.
#
# Authors:
#   - Ing. Cesar Florentin
#
# License: MIT (see full text below)
# -------------------------------------------------------------------
# MIT License:
# Permission is hereby granted, free of charge, to any person obtaining
# a copy of this software and associated files, to use, copy, modify,
# merge, publish, distribute, sublicense, and/or sell copies of the
# software. THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND.
# -------------------------------------------------------------------

set -e

GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Check root
if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}Please run as root (use sudo).${NC}"
    exit 1
fi

show_menu() {
    echo -e "${BLUE}========================================${NC}"
    echo -e "${GREEN}  MEMORY SERVICES INSTALLER${NC}"
    echo -e "${BLUE}========================================${NC}"
    echo "1) Install SWAP REFRESH service (timer)"
    echo "2) Install CACHE CLEANING service (continuous monitor)"
    echo "3) Install BOTH services"
    echo "4) UNINSTALL services"
    echo "5) Exit"
    echo -e "${BLUE}========================================${NC}"
    echo -n "Choose an option [1-5]: "
}

explain_timer() {
    echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${YELLOW}║  TIMER FORMAT (OnCalendar) - PRACTICAL EXAMPLES:            ║${NC}"
    echo -e "${YELLOW}╠══════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${YELLOW}║  *:0/10      →  Every 10 minutes (at 0,10,20...)            ║${NC}"
    echo -e "${YELLOW}║  *:0/5       →  Every 5 minutes                             ║${NC}"
    echo -e "${YELLOW}║  *:0/30      →  Every 30 minutes                            ║${NC}"
    echo -e "${YELLOW}║  hourly      →  Every hour (on the hour)                    ║${NC}"
    echo -e "${YELLOW}║  daily       →  Every day at 00:00                          ║${NC}"
    echo -e "${YELLOW}║  Mon..Fri 09:00:00 → Monday to Friday at 9 AM               ║${NC}"
    echo -e "${YELLOW}║  *-*-* 02:30:00   →  Every day at 2:30 AM                   ║${NC}"
    echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

install_swap() {
    echo -e "\n${GREEN}>>> Installing swap refresh service...${NC}"
    
    THRESHOLD_MEM=20
    THRESHOLD_SWAP=20
    TIMER_FREQUENCY="*:0/10"
    RANDOMIZED_DELAY_SEC=120
    
    read -p "Do you want to change thresholds and frequency? (y/n): " change
    if [[ "$change" =~ ^[yY]$ ]]; then
        read -p "Free memory threshold (%) [20]: " input
        THRESHOLD_MEM=${input:-20}
        read -p "Used swap threshold (%) [20]: " input
        THRESHOLD_SWAP=${input:-20}
        
        explain_timer
        read -p "Timer frequency (e.g., *:0/10, hourly, daily): " input
        TIMER_FREQUENCY=${input:-"*:0/10"}
        read -p "Maximum random delay (seconds) to avoid peaks [120]: " input
        RANDOMIZED_DELAY_SEC=${input:-120}
    fi
    
    SCRIPT_PATH="/usr/local/bin/refresh_swap.sh"
    cat > "$SCRIPT_PATH" << EOF
#!/bin/bash
THRESHOLD_MEM=$THRESHOLD_MEM
THRESHOLD_SWAP=$THRESHOLD_SWAP

read mem_total mem_available <<< \$(free -k | awk '/^Mem:/ {print \$2, \$7}')
mem_percent=\$((100 * mem_available / mem_total))

read swap_total swap_used <<< \$(free -k | awk '/^Swap:/ {print \$2, \$3}')
if [ \$swap_total -gt 0 ]; then
    swap_percent=\$((100 * swap_used / swap_total))
else
    swap_percent=0
fi

logger -t refresh-swap "Free memory: \${mem_percent}% | Swap used: \${swap_percent}%"

if [ \$mem_percent -ge \$THRESHOLD_MEM ] || [ \$swap_percent -gt \$THRESHOLD_SWAP ]; then
    logger -t refresh-swap "Condition met. Restarting swap..."
    /sbin/swapoff -a
    /sbin/swapon -a
    logger -t refresh-swap "Swap restarted successfully."
else
    logger -t refresh-swap "Condition not met. Doing nothing."
fi
EOF
    chmod +x "$SCRIPT_PATH"
    
    SERVICE_FILE="/etc/systemd/system/refresh-swap.service"
    cat > "$SERVICE_FILE" << EOF
[Unit]
Description=Refresh swap if free memory >= ${THRESHOLD_MEM}% or swap used > ${THRESHOLD_SWAP}%

[Service]
Type=oneshot
ExecStart=$SCRIPT_PATH
User=root
StandardOutput=journal
StandardError=journal
EOF

    TIMER_FILE="/etc/systemd/system/refresh-swap.timer"
    cat > "$TIMER_FILE" << EOF
[Unit]
Description=Timer for refresh-swap

[Timer]
OnCalendar=$TIMER_FREQUENCY
RandomizedDelaySec=$RANDOMIZED_DELAY_SEC
Persistent=true

[Install]
WantedBy=timers.target
EOF

    systemctl daemon-reload
    systemctl enable refresh-swap.timer
    systemctl start refresh-swap.timer
    
    echo -e "${GREEN}✓ refresh-swap service installed and activated.${NC}"
    echo "  - Frequency: $TIMER_FREQUENCY"
    echo "  - View logs: journalctl -u refresh-swap.service -f"
}

install_cache() {
    echo -e "\n${GREEN}>>> Installing cache cleaning service...${NC}"
    
    THRESHOLD_CACHE=40
    CHECK_INTERVAL=30
    DROP_CACHE_LEVEL=3
    
    read -p "Do you want to change cache cleaning parameters? (y/n): " change
    if [[ "$change" =~ ^[yY]$ ]]; then
        read -p "buff/cache threshold (%) that triggers cleaning [40]: " input
        THRESHOLD_CACHE=${input:-40}
        read -p "Check interval (seconds) [30]: " input
        CHECK_INTERVAL=${input:-30}
        read -p "drop_caches level (1=pagecache, 2=dentries, 3=both) [3]: " input
        DROP_CACHE_LEVEL=${input:-3}
    fi
    
    SCRIPT_PATH="/usr/local/bin/cache_percent_monitor.sh"
    cat > "$SCRIPT_PATH" << EOF
#!/bin/bash
THRESHOLD=$THRESHOLD_CACHE
INTERVAL=$CHECK_INTERVAL
LEVEL=$DROP_CACHE_LEVEL

while true; do
    read mem_total mem_buffcache <<< \$(free -k | awk '/^Mem:/ {print \$2, \$6}')
    cache_percent=\$((100 * mem_buffcache / mem_total))
    
    if [ \$cache_percent -gt \$THRESHOLD ]; then
        logger -t cache-percent-monitor "Cache: \${cache_percent}% (exceeds \${THRESHOLD}%). Cleaning..."
        sync
        echo \$LEVEL > /proc/sys/vm/drop_caches
        logger -t cache-percent-monitor "Cache cleaned (level \$LEVEL)"
    else
        logger -t cache-percent-monitor "Cache: \${cache_percent}% (within limit)"
    fi
    sleep \$INTERVAL
done
EOF
    chmod +x "$SCRIPT_PATH"
    
    SERVICE_FILE="/etc/systemd/system/cache-percent-monitor.service"
    cat > "$SERVICE_FILE" << EOF
[Unit]
Description=Cache monitor (buff/cache) - cleans if > ${THRESHOLD_CACHE}%
After=network.target

[Service]
Type=simple
ExecStart=$SCRIPT_PATH
Restart=always
RestartSec=10
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable cache-percent-monitor.service
    systemctl start cache-percent-monitor.service
    
    echo -e "${GREEN}✓ cache-percent-monitor service installed and activated.${NC}"
    echo "  - Threshold: ${THRESHOLD_CACHE}%, check every ${CHECK_INTERVAL}s"
    echo "  - View logs: journalctl -u cache-percent-monitor.service -f"
}

uninstall() {
    echo -e "\n${RED}>>> UNINSTALLING SERVICES${NC}"
    echo "What do you want to uninstall?"
    echo "1) Only swap service (refresh-swap)"
    echo "2) Only cache service (cache-percent-monitor)"
    echo "3) Both"
    echo -n "Choose [1-3]: "
    read opt_uninstall
    
    case $opt_uninstall in
        1)
            echo "Stopping and disabling refresh-swap.timer..."
            systemctl stop refresh-swap.timer 2>/dev/null || true
            systemctl disable refresh-swap.timer 2>/dev/null || true
            systemctl stop refresh-swap.service 2>/dev/null || true
            rm -f /etc/systemd/system/refresh-swap.timer
            rm -f /etc/systemd/system/refresh-swap.service
            rm -f /usr/local/bin/refresh_swap.sh
            echo -e "${GREEN}✓ Swap service uninstalled.${NC}"
            ;;
        2)
            echo "Stopping and disabling cache-percent-monitor..."
            systemctl stop cache-percent-monitor.service 2>/dev/null || true
            systemctl disable cache-percent-monitor.service 2>/dev/null || true
            rm -f /etc/systemd/system/cache-percent-monitor.service
            rm -f /usr/local/bin/cache_percent_monitor.sh
            echo -e "${GREEN}✓ Cache service uninstalled.${NC}"
            ;;
        3)
            echo "Uninstalling both..."
            systemctl stop refresh-swap.timer 2>/dev/null || true
            systemctl disable refresh-swap.timer 2>/dev/null || true
            systemctl stop refresh-swap.service 2>/dev/null || true
            rm -f /etc/systemd/system/refresh-swap.timer
            rm -f /etc/systemd/system/refresh-swap.service
            rm -f /usr/local/bin/refresh_swap.sh
            
            systemctl stop cache-percent-monitor.service 2>/dev/null || true
            systemctl disable cache-percent-monitor.service 2>/dev/null || true
            rm -f /etc/systemd/system/cache-percent-monitor.service
            rm -f /usr/local/bin/cache_percent_monitor.sh
            echo -e "${GREEN}✓ Both services uninstalled.${NC}"
            ;;
        *)
            echo -e "${RED}Invalid option. Returning to main menu.${NC}"
            return
            ;;
    esac
    
    systemctl daemon-reload
    echo -e "${YELLOW}Note: Old logs remain in journalctl. You can clean them with 'journalctl --rotate' if desired.${NC}"
}

# Main loop
while true; do
    show_menu
    read option
    case $option in
        1) install_swap ;;
        2) install_cache ;;
        3) install_swap; install_cache ;;
        4) uninstall ;;
        5) echo -e "${GREEN}Exiting...${NC}"; exit 0 ;;
        *) echo -e "${RED}Invalid option.${NC}" ;;
    esac
    echo ""
    read -p "Press Enter to continue..."
done
